# Database
SQL_DATABASE=aimathtutor
SQL_USERNAME=aimathtutor
SQL_PASSWORD=changeit

# AI API Keys (required only for cloud AI providers)
# Get API keys from: https://aistudio.google.com/app/apikey (Google)
#                    https://platform.openai.com/api-keys (OpenAI)
# Not needed for Ollama (local LLM)
app.google.api.key=your_google_api_key_here
app.openai.api.key=your_openai_api_key_here
app.openai.organization-id=your_openai_org_id_here

# SSRF protection: Comma-separated list of permitted hostnames for Ollama
app.security.allowed-ollama-hosts=ollama,localhost

# Encryption: Path to the AES-256 master key file
app.security.encryption-key-file=/etc/aimathtutor/keys/encryption.key


# Admin UI (only needed if pgadmin service is enabled in docker-compose.yml)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeit
