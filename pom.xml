<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.vptr</groupId>
  <artifactId>aimathtutor</artifactId>
  <version>${revision}</version>
  <packaging>quarkus</packaging>

  <properties>
    <!-- Placeholder to override with -Drevision= -->
    <revision>1.0.0-SNAPSHOT</revision>

    <!-- Project Settings -->
    <skipITs>true</skipITs>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <pmd-cpd.minTokens>65</pmd-cpd.minTokens>

    <!-- Quarkus Platform. Tracks the latest LTS line, NOT the latest stable release: LTS
    lines receive patch releases for far longer, which is what a project that ships releases
    needs. 3.33.x is the current LTS, so newer stable releases are deliberately not adopted;
    scripts/version_check.py reporting one as "outdated" is expected and informational, and
    .github/dependabot.yml ignores io.quarkus(.platform):* >=3.34.0 to match. Move to a new
    LTS line only, and raise the Dependabot bound in the same change. -->
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.version>3.33.3.1</quarkus.platform.version>

    <!-- Other Dependencies & Plugins -->
    <checkstyle.version>13.10.0</checkstyle.version>
    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
    <compiler-plugin.version>3.15.0</compiler-plugin.version>
    <dependency-check-plugin.version>13.0.0</dependency-check-plugin.version>
    <eclipse-formatter.version>4.40</eclipse-formatter.version>
    <error-prone.version>2.50.0</error-prone.version>
    <html-sanitizer.version>20260313.1</html-sanitizer.version>
    <!-- Must match the org.jacoco version bundled by io.quarkus:quarkus-jacoco (0.8.14 in Quarkus
    3.33.3.1). quarkus-jacoco offline-instruments the app classes with its own org.jacoco, which is
    what records @QuarkusTest coverage; a mismatched jacoco-maven-plugin cannot map that exec data,
    dropping all @QuarkusTest coverage to 0%.
    Bumped manually in lockstep with Quarkus only; scripts/version_check.py reporting a newer
    JaCoCo as "outdated" is expected and informational. Dependabot is configured to match. -->
    <jacoco-plugin.version>0.8.14</jacoco-plugin.version>
    <license-plugin.version>2.7.1</license-plugin.version>
    <line-awesome.version>2.1.0</line-awesome.version>
    <nullaway.version>0.13.8</nullaway.version>
    <pmd-plugin.version>3.28.0</pmd-plugin.version>
    <spotbugs-annotations.version>4.10.3</spotbugs-annotations.version>
    <spotbugs-plugin.version>4.10.3.0</spotbugs-plugin.version>
    <spotless-plugin.version>3.9.0</spotless-plugin.version>
    <surefire-plugin.version>3.5.6</surefire-plugin.version>
    <ulid-creator.version>5.2.4</ulid-creator.version>
    <vaadin.version>25.2.5</vaadin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Quarkus -->
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Vaadin -->
      <dependency>
        <groupId>com.vaadin</groupId>
        <artifactId>vaadin-bom</artifactId>
        <version>${vaadin.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Vaadin Core dependencies -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-quarkus-extension</artifactId>
      <version>${vaadin.version}</version>
    </dependency>

    <!-- Quarkus Core dependencies -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>

    <!-- PostgreSQL JDBC driver -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>

    <!-- Hibernate ORM with Panache for easier database operations -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>

    <!-- Bean Validator for entity validation -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>

    <!-- JSON processing -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>

    <!-- JSON-B API (for SpotBugs analysis of transitive dependencies) -->
    <dependency>
      <groupId>jakarta.json.bind</groupId>
      <artifactId>jakarta.json.bind-api</artifactId>
    </dependency>

    <!-- REST Client for AI API calls -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>

    <!-- Health checks via MicroProfile Health / SmallRye -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>

    <!-- MicroProfile Fault Tolerance for retry, timeout, fallback patterns -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
    </dependency>

    <!-- Quarkus Elytron Security Common for bcrypt hashing utilities -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-elytron-security-common</artifactId>
    </dependency>

    <!-- JSON formatter for logging -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>

    <!-- In-memory cache for read-mostly reference data (e.g. user ranks) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-cache</artifactId>
    </dependency>

    <!-- Line Awesome for icons -->
    <dependency>
      <groupId>org.parttio</groupId>
      <artifactId>line-awesome</artifactId>
      <version>${line-awesome.version}</version>
    </dependency>

    <!-- Quarkus Test Framework for unit and integration tests -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Mockito for mocking dependencies -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Add Panache Mock for entity mocking -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-panache-mock</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Add JaCoCo coverage for Quarkus. Required, not optional: it offline-instruments the
    application classes, which is the only way @QuarkusTest coverage reaches jacoco.exec.
    Removing it drops every service/repository/entity class to 0% (measured: 89.8% -> 28.1%),
    because the jacoco-maven-plugin's java agent cannot map classes loaded via
    QuarkusClassLoader. See the jacoco-plugin.version comment for the matching version pin. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jacoco</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- SpotBugs annotations for suppressing specific warnings -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>${spotbugs-annotations.version}</version>
    </dependency>

    <!-- OWASP Java HTML Sanitizer for safe stripping of HTML in user content -->
    <dependency>
      <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
      <artifactId>owasp-java-html-sanitizer</artifactId>
      <version>${html-sanitizer.version}</version>
    </dependency>

    <!-- ULID Creator for generating URL-safe unique identifiers -->
    <dependency>
      <groupId>com.github.f4b6a3</groupId>
      <artifactId>ulid-creator</artifactId>
      <version>${ulid-creator.version}</version>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>vaadin-prereleases</id>
      <url>https://maven.vaadin.com/vaadin-prereleases/</url>
    </repository>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>Vaadin Directory</id>
      <url>https://maven.vaadin.com/vaadin-addons</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </pluginRepository>
    <pluginRepository>
      <id>vaadin-prereleases</id>
      <url>https://maven.vaadin.com/vaadin-prereleases/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>${dependency-check-plugin.version}</version>
        <configuration>
          <failBuildOnCVSS>7</failBuildOnCVSS>
          <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
          <suppressionFiles>
            <suppressionFile>dependency-check-suppression.xml</suppressionFile>
          </suppressionFiles>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs-plugin.version}</version>
        <configuration>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
          <effort>Max</effort>
          <threshold>Low</threshold>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd-plugin.version}</version>
        <configuration>
          <minimumTokens>${pmd-cpd.minTokens}</minimumTokens>
          <targetJdk>${java.version}</targetJdk>
          <includeTests>true</includeTests>
          <linkXRef>false</linkXRef>
          <rulesets>
            <ruleset>pmd-ruleset.xml</ruleset>
          </rulesets>
          <failOnViolation>true</failOnViolation>
        </configuration>
        <executions>
          <execution>
            <id>pmd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
          <execution>
            <id>cpd-check</id>
            <phase>verify</phase>
            <goals>
              <goal>cpd-check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>checkstyle</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <configuration>
          <jvmArgs>--add-opens java.base/java.lang=ALL-UNNAMED
            --add-opens java.base/jdk.internal.ref=ALL-UNNAMED
            --add-opens java.base/jdk.internal.misc=ALL-UNNAMED
            --add-opens java.base/java.nio=ALL-UNNAMED
            --add-opens java.base/sun.nio.ch=ALL-UNNAMED
            --enable-native-access=ALL-UNNAMED
            --sun-misc-unsafe-memory-access=allow
            -XX:+EnableDynamicAgentLoading
            -Xshare:off
            -Dio.netty.tryReflectionSetAccessible=true
            -Dio.netty.allocator.useCacheForAllThreads=false</jvmArgs>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
        <configuration>
          <parameters>true</parameters>
          <compilerArgs>
            <!--
              -Werror: any compiler warning (javac lint or Error Prone) fails the build.
              -Xlint:all with three deliberate exclusions:
                -serial: Vaadin components are Serializable by inheritance; adding serialVersionUID
                         is unwanted boilerplate (same decision as the SE_ exclusion in spotbugs-exclude.xml)
                -this-escape: flags the standard Vaadin constructor-builds-UI idiom, not actual bugs
                -classfile: noise from third-party jars referencing optional annotations (e.g. OSGi
                            metadata in microprofile-config); not fixable in this repository
            -->
            <arg>-Werror</arg>
            <arg>-Xlint:all,-serial,-this-escape,-classfile</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR
              -XepOpt:NullAway:AnnotatedPackages=de.vptr.aimathtutor
              -Xep:FutureReturnValueIgnored:ERROR
              -Xep:NullablePrimitive:ERROR
              -Xep:NonApiType:ERROR
              -Xep:MultipleNullnessAnnotations:ERROR
              -Xep:JavaDurationGetSecondsToToSeconds:ERROR
              -Xep:JavaTimeDefaultTimeZone:ERROR
              -Xep:StringSplitter:ERROR
              -Xep:StringConcatToTextBlock:ERROR
              -Xep:StatementSwitchToExpressionSwitch:ERROR
              -Xep:UnnecessaryMethodReference:ERROR
              -Xep:UnusedVariable:ERROR
              -Xep:EffectivelyPrivate:ERROR</arg>
            <arg>--should-stop=ifError=FLOW</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${error-prone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <argLine>-Xshare:off -XX:+EnableDynamicAgentLoading @{argLine}</argLine>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Mirrors surefire. @{argLine} carries the JaCoCo agent, which failsafe would
          otherwise inherit only implicitly via the argLine property, and would lose
          silently the moment any explicit argLine is added here. -->
          <argLine>-Xshare:off -XX:+EnableDynamicAgentLoading @{argLine}</argLine>
          <systemPropertyVariables>
            <native.image.path>
              ${project.build.directory}/${project.build.finalName}-runner</native.image.path>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <!-- Bound to post-integration-test, not test: failsafe runs the *IT tests at
          integration-test and appends to the same jacoco.exec, so a report generated at
          test would omit all integration-test coverage. Still runs when ITs are skipped. -->
          <execution>
            <id>report</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.89</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.76</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <excludes>
            <exclude>de/vptr/aimathtutor/component/**</exclude>
            <exclude>de/vptr/aimathtutor/dto/**</exclude>
            <exclude>de/vptr/aimathtutor/view/**</exclude>
            <exclude>de/vptr/aimathtutor/AppConfig*</exclude>
            <exclude>de/vptr/aimathtutor/entity/CommentFlagEntity*</exclude>
            <exclude>de/vptr/aimathtutor/entity/UserGroupEntity*</exclude>
            <exclude>de/vptr/aimathtutor/entity/UserGroupMetaEntity*</exclude>
            <exclude>de/vptr/aimathtutor/event/CommentCreatedEvent.class</exclude>
            <exclude>de/vptr/aimathtutor/event/CommentCreatedEventBridge*</exclude>
            <exclude>de/vptr/aimathtutor/util/AdminFilterUtil*</exclude>
            <exclude>de/vptr/aimathtutor/util/AdminSearchLayoutFactory*</exclude>
            <exclude>de/vptr/aimathtutor/util/AiChatUtil*</exclude>
            <exclude>de/vptr/aimathtutor/util/AsyncDataLoader.class</exclude>
            <exclude>de/vptr/aimathtutor/util/GraspableMathConnector.class</exclude>
            <exclude>de/vptr/aimathtutor/util/LayoutNavigationUtil*</exclude>
            <exclude>de/vptr/aimathtutor/util/NotificationUtil*</exclude>
            <exclude>de/vptr/aimathtutor/util/PasswordUtil.class</exclude>
            <exclude>de/vptr/aimathtutor/util/GraspableEventFactory*</exclude>
            <exclude>de/vptr/aimathtutor/util/ExecutorShutdownUtil*</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${license-plugin.version}</version>
        <executions>
          <execution>
            <id>add-third-party</id>
            <phase>verify</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-plugin.version}</version>
        <configuration>
          <java>
            <eclipse>
              <file>${maven.multiModuleProjectDirectory}/eclipse-formatter.xml</file>
              <version>${eclipse-formatter.version}</version>
              <!-- download.eclipse.org suffers recurring outages; provision P2 from a mirror -->
              <p2Mirrors>
                <p2Mirror>
                  <prefix>https://download.eclipse.org/</prefix>
                  <url>https://ftp.halifax.rwth-aachen.de/eclipse/</url>
                </p2Mirror>
              </p2Mirrors>
            </eclipse>
            <importOrder>
              <order>java,javax,org,com,#</order>
            </importOrder>
            <removeUnusedImports />
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <skipITs>false</skipITs>
        <quarkus.native.enabled>true</quarkus.native.enabled>
      </properties>
    </profile>
    <profile>
      <id>production</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-maven-plugin</artifactId>
            <version>${vaadin.version}</version>
            <executions>
              <execution>
                <phase>compile</phase>
                <goals>
                  <goal>prepare-frontend</goal>
                  <goal>build-frontend</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        Regenerates the committed frontend manifest (package.json / package-lock.json)
        on demand via `make regen-frontend`. Unlike the production profile, this forces
        a full frontend build (forceProductionBuild) so npm actually resolves
        dependencies, and keeps the generated files (cleanFrontendFiles=false) instead
        of deleting them after bundling. Not part of the normal CI/production build.
      -->
      <id>regen-frontend</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-maven-plugin</artifactId>
            <version>${vaadin.version}</version>
            <configuration>
              <forceProductionBuild>true</forceProductionBuild>
              <cleanFrontendFiles>false</cleanFrontendFiles>
            </configuration>
            <executions>
              <execution>
                <phase>compile</phase>
                <goals>
                  <goal>prepare-frontend</goal>
                  <goal>build-frontend</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
