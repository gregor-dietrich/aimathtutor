<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.vptr.devkit</groupId>
    <artifactId>devkit-parent</artifactId>
    <version>0.5.0</version>
    <relativePath>.devkit/java/parent/pom.xml</relativePath>
  </parent>

  <groupId>de.vptr</groupId>
  <artifactId>aimathtutor</artifactId>
  <version>${revision}</version>
  <packaging>quarkus</packaging>

  <properties>
    <!-- Placeholder to override with -Drevision= -->
    <revision>1.0.0-SNAPSHOT</revision>

    <!-- Project Settings -->
    <skipITs>true</skipITs>
    <!-- The coverage minima below are calibrated against a run that includes the *IT
    tests, which are the only coverage of the repository package, so the check has to
    stand down when ITs are skipped. -->
    <jacoco.check.skip>${skipITs}</jacoco.check.skip>
    <jacoco.check.lineMinimum>0.89</jacoco.check.lineMinimum>
    <jacoco.check.branchMinimum>0.76</jacoco.check.branchMinimum>
    <nullaway.annotated.packages>de.vptr.aimathtutor</nullaway.annotated.packages>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Quarkus Platform. Tracks the latest LTS line, NOT the latest stable release: LTS
    lines receive patch releases for far longer, which is what a project that ships releases
    needs. 3.40.x is the current LTS, so newer stable releases are deliberately not adopted;
    `make check` reporting one as "outdated" is expected and informational, and
    .github/dependabot.yml ignores io.quarkus(.platform):* >=3.41.0 to match. Move to a new
    LTS line only, and raise the Dependabot bound in the same change. -->
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.version>3.40.1</quarkus.platform.version>

    <!-- Other Dependencies & Plugins -->
    <html-sanitizer.version>20260924.2</html-sanitizer.version>
    <line-awesome.version>2.1.0</line-awesome.version>
    <spotbugs-annotations.version>4.10.4</spotbugs-annotations.version>
    <ulid-creator.version>5.2.4</ulid-creator.version>
    <vaadin.version>25.3.1</vaadin.version>
    <!-- Node.js for every Vaadin frontend build. vaadin-maven-plugin reads these two properties
    directly; quarkus-maven-plugin passes them to the Quarkus build step and to dev mode (see its
    systemProperties). Vaadin downloads this version to ~/.vaadin instead of using a node on PATH,
    so the npm bundled with it, and with that package-lock.json, is the same on every machine.
    Bump together with vaadin.version, to the new release's FrontendTools.DEFAULT_NODE_VERSION. -->
    <vaadin.node.version>v24.21.0</vaadin.node.version>
    <vaadin.require.home.node>true</vaadin.require.home.node>
    <!-- npm ci instead of npm install: installs exactly what package-lock.json records and fails
    the build when package.json and the lockfile disagree, instead of rewriting the lockfile.
    Off only in the regen-frontend profile, which recreates the lockfile from scratch. -->
    <vaadin.ci.build>true</vaadin.ci.build>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Quarkus -->
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Vaadin -->
      <dependency>
        <groupId>com.vaadin</groupId>
        <artifactId>vaadin-bom</artifactId>
        <version>${vaadin.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Vaadin Core dependencies -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>vaadin-quarkus-extension</artifactId>
      <version>${vaadin.version}</version>
    </dependency>

    <!-- Quarkus Core dependencies -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>

    <!-- PostgreSQL JDBC driver -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>

    <!-- Hibernate ORM with Panache for easier database operations -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>

    <!-- Flyway schema migrations -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway-postgresql</artifactId>
    </dependency>

    <!-- Bean Validator for entity validation -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>

    <!-- JSON processing -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>

    <!-- JSON-B API (for SpotBugs analysis of transitive dependencies) -->
    <dependency>
      <groupId>jakarta.json.bind</groupId>
      <artifactId>jakarta.json.bind-api</artifactId>
    </dependency>

    <!-- REST Client for AI API calls -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-client-jackson</artifactId>
    </dependency>

    <!-- Health checks via MicroProfile Health / SmallRye -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>

    <!-- MicroProfile Fault Tolerance for retry, timeout, fallback patterns -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
    </dependency>

    <!-- Quarkus Elytron Security Common for bcrypt hashing utilities -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-elytron-security-common</artifactId>
    </dependency>

    <!-- JSON formatter for logging -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>

    <!-- In-memory cache for read-mostly reference data (e.g. user ranks) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-cache</artifactId>
    </dependency>

    <!-- Line Awesome for icons -->
    <dependency>
      <groupId>org.parttio</groupId>
      <artifactId>line-awesome</artifactId>
      <version>${line-awesome.version}</version>
    </dependency>

    <!-- Quarkus Test Framework for unit and integration tests -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Mockito for mocking dependencies -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-mockito</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Add Panache Mock for entity mocking -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-panache-mock</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Add JaCoCo coverage for Quarkus. Required, not optional: it offline-instruments the
    application classes, which is the only way @QuarkusTest coverage reaches jacoco.exec.
    Removing it drops every service/repository/entity class to 0% (measured: 89.8% -> 28.1%),
    because the jacoco-maven-plugin's java agent cannot map classes loaded via
    QuarkusClassLoader. Its org.jacoco version is aligned with the plugin in the devkit parent's dependencyManagement. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jacoco</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- SpotBugs annotations for suppressing specific warnings -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>${spotbugs-annotations.version}</version>
    </dependency>

    <!-- OWASP Java HTML Sanitizer for safe stripping of HTML in user content -->
    <dependency>
      <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
      <artifactId>owasp-java-html-sanitizer</artifactId>
      <version>${html-sanitizer.version}</version>
    </dependency>

    <!-- ULID Creator for generating URL-safe unique identifiers -->
    <dependency>
      <groupId>com.github.f4b6a3</groupId>
      <artifactId>ulid-creator</artifactId>
      <version>${ulid-creator.version}</version>
    </dependency>
  </dependencies>

  <!-- No repositories besides Central (Maven's default): without the .devkit link, Maven asks
  every declared repository for devkit's parent POM, and whatever answers would configure the
  build. Every dependency resolves from Central. -->

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <configuration>
          <jvmArgs>--add-opens java.base/java.lang=ALL-UNNAMED
            --add-opens java.base/jdk.internal.ref=ALL-UNNAMED
            --add-opens java.base/jdk.internal.misc=ALL-UNNAMED
            --add-opens java.base/java.nio=ALL-UNNAMED
            --add-opens java.base/sun.nio.ch=ALL-UNNAMED
            --enable-native-access=ALL-UNNAMED
            --sun-misc-unsafe-memory-access=allow
            -XX:+EnableDynamicAgentLoading
            -Xshare:off
            -Dio.netty.tryReflectionSetAccessible=true
            -Dio.netty.allocator.useCacheForAllThreads=false</jvmArgs>
          <systemProperties>
            <!-- vaadin.build.*: Quarkus build step; vaadin.*: dev mode's runtime dev server -->
            <vaadin.build.node-version>${vaadin.node.version}</vaadin.build.node-version>
            <vaadin.build.require-home-node-exec>${vaadin.require.home.node}</vaadin.build.require-home-node-exec>
            <vaadin.build.ci-build>${vaadin.ci.build}</vaadin.build.ci-build>
            <vaadin.node.version>${vaadin.node.version}</vaadin.node.version>
            <vaadin.require.home.node>${vaadin.require.home.node}</vaadin.require.home.node>
          </systemProperties>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>de/vptr/aimathtutor/component/**</exclude>
            <exclude>de/vptr/aimathtutor/dto/**</exclude>
            <exclude>de/vptr/aimathtutor/view/**</exclude>
            <exclude>de/vptr/aimathtutor/AppConfig*</exclude>
            <exclude>de/vptr/aimathtutor/entity/CommentFlagEntity*</exclude>
            <exclude>de/vptr/aimathtutor/entity/UserGroupEntity*</exclude>
            <exclude>de/vptr/aimathtutor/entity/UserGroupMetaEntity*</exclude>
            <exclude>de/vptr/aimathtutor/event/CommentCreatedEvent.class</exclude>
            <exclude>de/vptr/aimathtutor/event/CommentCreatedEventBridge*</exclude>
            <exclude>de/vptr/aimathtutor/util/AdminFilterUtil*</exclude>
            <exclude>de/vptr/aimathtutor/util/AdminSearchLayoutFactory*</exclude>
            <exclude>de/vptr/aimathtutor/util/AiChatUtil*</exclude>
            <exclude>de/vptr/aimathtutor/util/AsyncDataLoader.class</exclude>
            <exclude>de/vptr/aimathtutor/util/GraspableMathConnector.class</exclude>
            <exclude>de/vptr/aimathtutor/util/LayoutNavigationUtil*</exclude>
            <exclude>de/vptr/aimathtutor/util/NotificationUtil*</exclude>
            <exclude>de/vptr/aimathtutor/util/PasswordUtil.class</exclude>
            <exclude>de/vptr/aimathtutor/util/GraspableEventFactory*</exclude>
            <exclude>de/vptr/aimathtutor/util/ExecutorShutdownUtil*</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <skipITs>false</skipITs>
        <quarkus.native.enabled>true</quarkus.native.enabled>
      </properties>
    </profile>
    <profile>
      <id>production</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-maven-plugin</artifactId>
            <version>${vaadin.version}</version>
            <executions>
              <execution>
                <phase>compile</phase>
                <goals>
                  <goal>prepare-frontend</goal>
                  <goal>build-frontend</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        Regenerates the committed frontend manifest (package.json / package-lock.json)
        on demand via `make regen-frontend`. Unlike the production profile, this forces
        a full frontend build (forceProductionBuild) so npm actually resolves
        dependencies, keeps the generated files (cleanFrontendFiles=false) instead
        of deleting them after bundling, and runs npm install rather than npm ci
        (ciBuild=false), because there is no lockfile yet to install from. Not part of
        the normal CI/production build.
      -->
      <id>regen-frontend</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-maven-plugin</artifactId>
            <version>${vaadin.version}</version>
            <configuration>
              <forceProductionBuild>true</forceProductionBuild>
              <cleanFrontendFiles>false</cleanFrontendFiles>
              <ciBuild>false</ciBuild>
            </configuration>
            <executions>
              <execution>
                <phase>compile</phase>
                <goals>
                  <goal>prepare-frontend</goal>
                  <goal>build-frontend</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>