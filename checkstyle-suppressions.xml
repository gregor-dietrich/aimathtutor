<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN" "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- UlidCreator may only be imported by UlidUtil itself -->
    <suppress id="IllegalImport.UlidCreator" files="UlidUtil\.java$" />
    <!-- REST Assured may only be imported by TestUtil itself -->
    <suppress id="IllegalImport.RestAssured" files="TestUtil\.java$" />
    <!-- Jackson response DTOs: the no-arg deserialization constructor legitimately
         leaves fields unset until Jackson populates them via setters; marking every
         field @Nullable would be pessimistic for the hundreds of reliably-populated
         read sites. -->
    <suppress id="SuppressWarningsNullAway"
        files="[/\\]de[/\\]vptr[/\\]aimathtutor[/\\]dto[/\\]" />
    <!-- EXISTING DEBT, not an exemption on the merits: 18 class- and method-level
         @SuppressWarnings("NullAway") remain across 16 Vaadin view/component classes.
         The way to close the hole is to annotate the lazily-built UI fields
         @Nullable and read them through locals. Narrow this pattern as files are converted, and
         delete it when the last one is gone. -->
    <suppress id="SuppressWarningsNullAway"
        files="[/\\]de[/\\]vptr[/\\]aimathtutor[/\\](view|component)[/\\]" />
</suppressions>
