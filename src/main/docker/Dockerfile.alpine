####
# This Dockerfile is used in order to build a container that runs the Quarkus application in JVM mode
#
# Before building the container image run:
#
# ./mvnw package -Pproduction
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.alpine -t quarkus/aimathtutor-jvm .
#
# Then run the container using:
#
# Mount the key volume, or --rm discards the key and a later start refuses a database holding email addresses.
# Datasource and admin settings: docs/QUICKSTART.md.
# docker run -i --rm -p 9001:9001 -v aimathtutor_keys:/etc/aimathtutor/keys \
#   -e app.security.encryption-key-file=/etc/aimathtutor/keys/encryption.key quarkus/aimathtutor-jvm
#
# Java runs directly as PID 1. ENTRYPOINT holds only the runtime JVM arguments the jar needs (AGENTS.md, Build & Development): none.
# Add operator JVM options with JDK_JAVA_OPTIONS, for example:
# docker run -i --rm -p 9001:9001 -e JDK_JAVA_OPTIONS="-Xmx512m" quarkus/aimathtutor-jvm
#
###
FROM eclipse-temurin:25.0.4.1_1-jre-alpine-3.24@sha256:3c0a9084927a221ccd1d007fcaf614465672c0af37aaa834c5184483afe56d61

ENV LANGUAGE='en_US:en'

RUN apk add --no-cache wget

# Create application user
RUN addgroup -g 185 -S jboss && adduser -u 185 -S -G jboss -h /deployments -s /sbin/nologin jboss

# We make four distinct layers so if there are application changes the library layers can be re-used
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

# Create logs and encryption key directories with proper permissions for the jboss user
RUN mkdir -p /deployments/logs /etc/aimathtutor/keys && chown -R 185:185 /deployments/logs /etc/aimathtutor/keys

EXPOSE 9001
USER 185
WORKDIR /deployments

ENTRYPOINT [ "java", "-jar", "/deployments/quarkus-run.jar" ]
CMD []

HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=10s \
    CMD wget --no-verbose --tries=1 --spider http://localhost:9001/q/health/ready || exit 1
